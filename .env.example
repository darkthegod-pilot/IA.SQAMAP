# Vlad Volkov — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# O arquivo .env NÃO deve ser commitado no git

# API Key do OpenAI (GPT) para o chat com Vlad IA
# Pode ser configurada também via menu [9] Configurações do framework
# Prioridade: OPENAI_API_KEY (env) > ~/.vlad/config.json (persistente)
OPENAI_API_KEY=sk-proj-...

# Proxy para requisições HTTP (opcional)
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080
